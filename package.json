{
  "name": "prayer-planner",
  "productName": "Мой день",
  "version": "0.1.0",
  "private": true,
  "description": "Personal daily planner built around prayer times with loud slot alarms (Windows).",
  "license": "MIT",
  "main": "dist-electron/electron/main.js",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "typecheck": "tsc -p tsconfig.web.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "build:electron": "tsc -p tsconfig.node.json",
    "build:renderer": "vite build",
    "build": "npm run typecheck && npm run build:electron && npm run build:renderer",
    "test": "vitest run",
    "start": "electron .",
    "dist": "npm run build && electron-builder --win",
    "gen:alarm": "node scripts/gen-alarm.mjs"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "typescript": "^5.5.4",
    "vite": "^5.4.8",
    "vitest": "^2.1.1"
  }
}